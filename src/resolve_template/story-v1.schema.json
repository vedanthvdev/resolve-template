{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vedanthvdev/resolve-template/schemas/story-v1.schema.json",
  "title": "resolve-template story v1",
  "type": "object",
  "required": ["version", "fps", "timeline", "video"],
  "properties": {
    "version": { "const": "1" },
    "title": { "type": "string" },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "timeline": {
      "type": "object",
      "required": ["name", "duration_frames"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "duration_frames": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "video": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot", "filename", "track", "start_frame", "duration_frames"],
        "properties": {
          "shot": { "type": "integer", "minimum": 1 },
          "filename": { "type": "string", "minLength": 1 },
          "track": { "const": "V1" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "filename", "track", "start_frame", "duration_frames"],
        "properties": {
          "role": { "enum": ["vo", "music", "sfx"] },
          "filename": { "type": "string", "minLength": 1 },
          "track": { "enum": ["A1", "A2", "A3"] },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "name", "color"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1 },
          "color": {
            "enum": [
              "Blue", "Cyan", "Green", "Yellow", "Red", "Pink", "Purple",
              "Fuchsia", "Rose", "Lavender", "Sky", "Mint", "Lemon",
              "Sand", "Cocoa", "Cream"
            ]
          },
          "duration": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "bins": {
      "type": "array",
      "prefixItems": [
        { "const": "01_VIDEO_PLACEHOLDERS" },
        { "const": "02_AUDIO_VO" },
        { "const": "03_AUDIO_MUSIC" },
        { "const": "04_AUDIO_SFX" },
        { "const": "05_GRAPHICS" },
        { "const": "06_REFERENCE" }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["cut", "cross_dissolve", "fade_from_black", "fade_to_black"]
          },
          "after_shot": { "type": "integer", "minimum": 1 },
          "shot": { "type": "integer", "minimum": 1 },
          "duration_frames": { "type": "integer", "minimum": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "cross_dissolve" } } },
            "then": { "required": ["after_shot", "duration_frames"] }
          },
          {
            "if": {
              "properties": {
                "kind": { "enum": ["fade_from_black", "fade_to_black"] }
              }
            },
            "then": { "required": ["shot", "duration_frames"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "titles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "track", "start_frame", "duration_frames"],
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "track": { "const": "V2" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
