{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vedanthvdev/resolve-template/schemas/story-v1.schema.json",
  "title": "resolve-template story v1",
  "type": "object",
  "$defs": {
    "time": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?s$" }
      ]
    }
  },
  "required": ["version", "fps", "timeline", "video"],
  "properties": {
    "version": { "const": "1" },
    "title": { "type": "string" },
    "fps": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 16, "multipleOf": 2 },
    "height": { "type": "integer", "minimum": 16, "multipleOf": 2 },
    "timeline": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "duration": { "$ref": "#/$defs/time" }
      },
      "not": { "required": ["duration_frames", "duration"] },
      "additionalProperties": false
    },
    "video": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot", "track"],
        "properties": {
          "shot": { "type": "integer", "minimum": 1 },
          "filename": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "color": { "enum": ["Blue", "Green", "Yellow", "Pink", "Purple"] },
          "linked_audio": { "type": "boolean" },
          "track": { "const": "V1" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "start": { "$ref": "#/$defs/time" },
          "duration": { "$ref": "#/$defs/time" }
        },
        "allOf": [
          {
            "oneOf": [
              { "required": ["duration_frames"] },
              { "required": ["duration"] }
            ]
          },
          { "not": { "required": ["start_frame", "start"] } }
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "track"],
        "properties": {
          "role": { "enum": ["vo", "music", "sfx"] },
          "filename": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "track": { "enum": ["A1", "A2", "A3"] },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "start": { "$ref": "#/$defs/time" },
          "duration": { "$ref": "#/$defs/time" }
        },
        "allOf": [
          {
            "oneOf": [
              { "required": ["start_frame"] },
              { "required": ["start"] }
            ]
          },
          {
            "oneOf": [
              { "required": ["duration_frames"] },
              { "required": ["duration"] }
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "color"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "at": { "$ref": "#/$defs/time" },
          "name": { "type": "string", "minLength": 1 },
          "color": {
            "enum": [
              "Blue", "Cyan", "Green", "Yellow", "Red", "Pink", "Purple",
              "Fuchsia", "Rose", "Lavender", "Sky", "Mint", "Lemon",
              "Sand", "Cocoa", "Cream"
            ]
          },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "duration": { "$ref": "#/$defs/time" },
          "note": { "type": "string" }
        },
        "allOf": [
          {
            "oneOf": [
              { "required": ["frame"] },
              { "required": ["at"] }
            ]
          },
          { "not": { "required": ["duration_frames", "duration"] } }
        ],
        "additionalProperties": false
      }
    },
    "bins": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        {
          "type": "object",
          "properties": {
            "video": { "type": "string", "minLength": 1 },
            "vo": { "type": "string", "minLength": 1 },
            "music": { "type": "string", "minLength": 1 },
            "sfx": { "type": "string", "minLength": 1 },
            "graphics": { "type": "string", "minLength": 1 },
            "reference": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["cut", "cross_dissolve", "fade_from_black", "fade_to_black"]
          },
          "after_shot": { "type": "integer", "minimum": 1 },
          "shot": { "type": "integer", "minimum": 1 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "duration": { "$ref": "#/$defs/time" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "cross_dissolve" } } },
            "then": {
              "required": ["after_shot"],
              "oneOf": [
                { "required": ["duration_frames"] },
                { "required": ["duration"] }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": { "enum": ["fade_from_black", "fade_to_black"] }
              }
            },
            "then": {
              "required": ["shot"],
              "oneOf": [
                { "required": ["duration_frames"] },
                { "required": ["duration"] }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "titles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["track"],
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "track": { "const": "V2" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "start": { "$ref": "#/$defs/time" },
          "duration": { "$ref": "#/$defs/time" }
        },
        "allOf": [
          {
            "oneOf": [
              { "required": ["start_frame"] },
              { "required": ["start"] }
            ]
          },
          {
            "oneOf": [
              { "required": ["duration_frames"] },
              { "required": ["duration"] }
            ]
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
